<?xml version="1.0" encoding="utf-8"?>
<!-- «Режим авто» (CarModeActivity): a few colours of its own in each scheme, high contrast and calm at night -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <attr name="carBackground" format="color" />
    <attr name="carForeground" format="color" />
    <!-- the progress fill -->
    <attr name="carAccent" format="color" />
    <!-- the progress track, the divider and the close button -->
    <attr name="carTrack" format="color" />
    <attr name="carPlay" format="color" />
    <attr name="carPlayGlyph" format="color" />
    <!-- the pressed state of a target -->
    <attr name="carPress" format="color" />

    <style name="AppTheme.CarMode" parent="AppTheme.NoActionBar">
        <item name="carBackground">?attr/colorBackgroundMain</item>
        <item name="carForeground">?attr/colorPrimaryText</item>
        <item name="carAccent">?attr/colorAccentPrimary</item>
        <item name="carTrack">?attr/colorSurfaceCard</item>
        <item name="carPlay">?attr/colorAccentPrimary</item>
        <item name="carPlayGlyph">?attr/colorBackgroundMain</item>
        <item name="carPress">#33FFFFFF</item>
        <item name="android:windowBackground">?attr/carBackground</item>
        <item name="android:statusBarColor">?attr/carBackground</item>
        <item name="android:navigationBarColor">?attr/carBackground</item>
    </style>

    <style name="AppThemeBlack.CarMode" parent="AppThemeBlack.NoActionBar">
        <item name="carBackground">?attr/colorBackgroundMain</item>
        <item name="carForeground">?attr/colorPrimaryText</item>
        <item name="carAccent">?attr/colorAccentPrimary</item>
        <item name="carTrack">?attr/colorSurfaceCard</item>
        <item name="carPlay">?attr/colorAccentPrimary</item>
        <item name="carPlayGlyph">?attr/colorBackgroundMain</item>
        <item name="carPress">#2EFFFFFF</item>
        <item name="android:windowBackground">?attr/carBackground</item>
        <item name="android:statusBarColor">?attr/carBackground</item>
        <item name="android:navigationBarColor">?attr/carBackground</item>
    </style>

    <style name="LightAppTheme.CarMode" parent="LightAppTheme.NoActionBar">
        <item name="carBackground">?attr/colorBackgroundMain</item>
        <item name="carForeground">?attr/colorPrimaryText</item>
        <item name="carAccent">?attr/colorAccentPrimary</item>
        <item name="carTrack">?attr/colorSurfaceCard</item>
        <item name="carPlay">?attr/colorAccentPrimary</item>
        <item name="carPlayGlyph">?attr/colorBackgroundMain</item>
        <item name="carPress">#1F000000</item>
        <item name="android:windowBackground">?attr/carBackground</item>
        <item name="android:statusBarColor">?attr/carBackground</item>
        <item name="android:navigationBarColor">?attr/carBackground</item>
    </style>

    <style name="CarModeCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
