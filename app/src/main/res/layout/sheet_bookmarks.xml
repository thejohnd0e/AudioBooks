<?xml version="1.0" encoding="utf-8"?>
<!-- «Закладки» (fragment.BookmarksSheet): the marks of a book in book order, "add here" on top. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:theme="@style/ThemeOverlay.App.Sources"
    tools:viewBindingIgnore="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/bookmarks_title"
        android:textColor="?attr/colorPrimaryText"
        android:textSize="19sp"
        android:textStyle="bold"
        tools:ignore="UnusedAttribute" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bookmarkHere"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/bookmark_here"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimaryText"
        app:icon="@drawable/ic_bookmark_outline"
        app:iconTint="?attr/colorAccentPrimary"
        app:strokeColor="?attr/colorTextMuted"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/bookmarksEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/bookmarks_empty"
        android:textColor="@color/sources_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bookmarksList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
