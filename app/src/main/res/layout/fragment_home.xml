<?xml version="1.0" encoding="utf-8"?>
<!-- «Продолжить» (fragment.HomeFragment): the books to continue, the saved ones, and the empty start. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/recycler_item_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/recycler_item_margin"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/homeContinueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/home_continue"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="UnusedAttribute"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeContinueList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/homeSavedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/home_saved"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="UnusedAttribute"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeSavedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/homeNewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/home_new_releases"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="UnusedAttribute"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeNewList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/homeEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/home_empty"
                android:textColor="?attr/subTextColor"
                android:textSize="@dimen/titleSize" />

            <Button
                android:id="@+id/homeOpenCatalog"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/home_open_catalog"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimaryText"
                app:strokeColor="?attr/colorTextMuted"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
