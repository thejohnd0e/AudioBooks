<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Preview comparison: Old vs New -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_picker_current"
                android:textColor="?attr/colorTextMuted"
                android:textSize="11sp" />

            <View
                android:id="@+id/colorPreviewCurrent"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="6dp"
                android:background="#141816" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_picker_new"
                android:textColor="?attr/colorTextMuted"
                android:textSize="11sp" />

            <View
                android:id="@+id/colorPreviewNew"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="4dp"
                android:background="#141816" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Presets Swatches Container -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Быстрый выбор"
        android:textColor="?attr/colorTextMuted"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/swatchesGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:alignmentMode="alignMargins"
        android:columnCount="6"
        android:useDefaultMargins="true" />

    <!-- HEX input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/hexInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/color_picker_hex_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/hexInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLength="7"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
