<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.BookActivity"
    tools:viewBindingIgnore="true">

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        tools:background="?attr/backgraundColor">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/activity_horizontal_margin">

            <!-- Top Header Block: Card Cover + Main Metadata -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/book_cover_weight"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceCard">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/book_cover"
                        android:scaleType="fitCenter"
                        tools:srcCompat="@tools:sample/avatars[2]" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_genre_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/colorAccentPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Фантастика" />

                    <!-- "Автор — Название": the author toggles the author, the title the book; a long press copies it -->
                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/colorPrimaryText"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Роулинг Джоан — Гарри Поттер и Орден Феникса" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/like"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/text_margin_book_description"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/subTextColor"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_like"
                            tools:text="10" />

                        <TextView
                            android:id="@+id/disLike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/text_margin_book_description"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/subTextColor"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_dislike"
                            tools:text="10" />

                        <TextView
                            android:id="@+id/favorite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/text_margin_book_description"
                            android:drawablePadding="3dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/subTextColor"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_site_favorites"
                            tools:text="213" />

                        <TextView
                            android:id="@+id/reting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="3dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/subTextColor"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_reting"
                            tools:text="4 972" />
                    </LinearLayout>

                    <!-- the book's length; once started, what is left at the current speed -->
                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="4dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/subTextColor"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_clock"
                        tools:text="осталось 5 ч. 12 мин." />

                    <!-- under a started book's time: how much is behind, with the speed or the chapter beside it -->
                    <LinearLayout
                        android:id="@+id/timeProgressRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/book_time_bar_inset"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/timeProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:max="1000"
                            app:indicatorColor="?attr/colorAccentPrimary"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="@dimen/book_time_bar_height"
                            tools:progress="430" />

                        <TextView
                            android:id="@+id/timeNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/subTextColor"
                            android:textSize="@dimen/subTextSize"
                            android:visibility="gone"
                            tools:text="при 1,5×"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- the site of the book, opening its card (SourceActivity); hidden for an unknown host -->
                    <TextView
                        android:id="@+id/bookSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="4dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/hrefColor"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_source_layers"
                        tools:text="Книга в ухе" />

                </LinearLayout>

            </LinearLayout>

            <!-- Metadata Rows: Author, Reader, Series -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/autorConteiner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/authorLabel"
                        android:layout_width="@dimen/text_width"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:text="@string/autor"
                        android:textColor="?attr/subTextColor"
                        android:textSize="@dimen/textSizeBookDescription"
                        app:drawableStartCompat="@drawable/ic_autor" />

                    <TextView
                        android:id="@+id/author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/recycler_item_textmargin"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:textColor="?attr/hrefColor"
                        android:textSize="@dimen/textSizeBookDescription"
                        tools:text="Роулинг Джоан" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/artistConteiner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/artistLabel"
                        android:layout_width="@dimen/text_width"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:text="@string/artist"
                        android:textColor="?attr/subTextColor"
                        android:textSize="@dimen/textSizeBookDescription"
                        app:drawableStartCompat="@drawable/ic_artist" />

                    <TextView
                        android:id="@+id/artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/recycler_item_textmargin"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:textColor="?attr/hrefColor"
                        android:textSize="@dimen/textSizeBookDescription"
                        tools:text="Клюквин Александр" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/seriesConteiner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/seriesLabel"
                        android:layout_width="@dimen/text_width"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:text="@string/series"
                        android:textColor="?attr/subTextColor"
                        android:textSize="@dimen/textSizeBookDescription"
                        app:drawableStartCompat="@drawable/ic_book" />

                    <TextView
                        android:id="@+id/series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/recycler_item_textmargin"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:textColor="?attr/hrefColor"
                        android:textSize="@dimen/textSizeBookDescription"
                        tools:text="Гарри Поттер" />
                </LinearLayout>

            </LinearLayout>

            <!-- Action Buttons: Primary Listen Button + Secondary Favorites/Download -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnListenBook"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/action_listen"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorBackgroundMain"
                app:backgroundTint="?attr/colorAccentPrimary"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorBackgroundMain" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavoriteBook"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/action_to_favorites"
                    android:textColor="?attr/colorPrimaryText"
                    android:textSize="13sp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_favorite_add"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorAccentPrimary"
                    app:strokeColor="?attr/colorTextMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadBook"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/action_download"
                    android:textColor="?attr/colorPrimaryText"
                    android:textSize="13sp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorAccentPrimary"
                    app:strokeColor="?attr/colorTextMuted" />
            </LinearLayout>

            <!-- Description Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="14dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/descLine"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="?attr/colorTextMuted"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineSpacingExtra="3dp"
                        android:textColor="?attr/colorPrimaryText"
                        android:textSize="14sp"
                        tools:text="Гарри Поттер с нетерпением ждет окончания каникул и начала пятого учебного года в Хогвартсе." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/copyDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/copy"
                            android:textColor="?attr/hrefColor"
                            android:textSize="@dimen/textSizeBookDescription"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/showMore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/show_more"
                            android:textAlignment="center"
                            android:textColor="?attr/colorAccentPrimary"
                            android:textSize="@dimen/textSizeBookDescription"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recommendations / Other Books Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceCard"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="14dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/otherBookLine"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="?attr/colorTextMuted"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recommendedBooksTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/other_recomended_books"
                        android:textColor="?attr/colorPrimaryText"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recommendedBooks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
