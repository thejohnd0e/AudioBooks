<?xml version="1.0" encoding="utf-8"?>
<!-- The TV's player is a screen of its own (BookActivity shows it after «Слушать», the book's page is the other one):
     the book on the left, the chapters, the progress and the controls on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="?attr/backgraundColor"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingTop="24dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/playerCover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/playerBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerBookAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/subTextColor"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="6"
        android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/text_margin"
        android:paddingBottom="@dimen/text_margin"
        tools:showIn="@layout/player">

        <!-- the chapter selection: close, all/some/none chosen, the count in name_curent, download, delete -->
        <ImageButton
            android:id="@+id/selectionClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/text_margin"
            android:background="@drawable/focusable"
            android:contentDescription="@string/selection_close"
            android:focusable="true"
            android:src="@drawable/ic_close"
            android:visibility="gone" />

        <TextView
            android:id="@+id/radioAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/text_margin"
            android:background="@drawable/focusable"
            android:drawableStart="@drawable/ic_check_circle_outline"
            android:drawablePadding="@dimen/text_margin_book_description"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:text="@string/all"
            android:textColor="?attr/colorPrimaryText"
            android:visibility="gone" />

        <TextView
            android:id="@+id/name_curent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_margin"
            android:layout_weight="1"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="@dimen/titleSize"
            tools:text="0001"
            tools:textColor="#000" />


        <ImageButton
            android:id="@+id/dowland"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/text_margin"
            android:background="@drawable/focusable"
            android:contentDescription="@string/dowland"
            android:focusable="true"
            android:src="@drawable/ic_download"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/text_margin"
            android:background="@drawable/focusable"
            android:contentDescription="@string/delete"
            android:focusable="true"
            android:src="@drawable/ic_delete"
            android:visibility="gone" />
    </LinearLayout>


    <!-- what the book's download is doing: state, chapters, bytes, speed, time left; opens the Downloads screen -->
    <LinearLayout
        android:id="@+id/downloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="@dimen/text_margin"
        android:paddingEnd="@dimen/text_margin"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/downloadStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/subTextColor"
            android:textSize="@dimen/subTextSize"
            tools:text="Скачивается · 12/40 глав · 245 МБ из ≈1,1 ГБ · 950 КБ/с · ~15 мин" />

        <ProgressBar
            android:id="@+id/downloadStatusBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="100"
            tools:progress="30" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/seekBar"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/text_margin"
        android:paddingTop="@dimen/text_margin"
        android:paddingEnd="@dimen/text_margin">

        <TextView
            android:id="@+id/timeStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_zero"
            android:textColor="?attr/colorPrimaryText" />

        <com.fanok.audiobooks.TvSeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/list"
            android:layout_weight="1"
            android:focusable="true" />

        <TextView
            android:id="@+id/timeEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_zero"
            android:textColor="?attr/colorPrimaryText" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_row_height"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="horizontal"
        android:padding="@dimen/text_margin">

        <ImageButton
            android:id="@+id/rewind"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/focusable"
            android:contentDescription="@string/seek_back_generic"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rewind_30" />


        <ImageButton
            android:id="@+id/previousBottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/focusable"
            android:contentDescription="@string/previous"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/playBottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/focusable"
            android:contentDescription="@string/play"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/nextBottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/focusable"
            android:contentDescription="@string/next"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/forward"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/focusable"
            android:contentDescription="@string/seek_forward_generic"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fast_forward_30" />


    </LinearLayout>


    <include layout="@layout/player_actions" />
    </LinearLayout>
</LinearLayout>
