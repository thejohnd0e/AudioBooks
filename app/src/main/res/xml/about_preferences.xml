<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:icon="@drawable/ic_version"
        android:key="version" />

    <!-- update.Updater: a check at the start and every 1.5 h; the line above checks by hand either way -->
    <CheckBoxPreference
        android:defaultValue="true"
        android:icon="@drawable/ic_update"
        android:key="auto_update"
        android:summary="@string/auto_update_desc"
        android:title="@string/auto_update" />

    <!-- update.Updater.PREF_BETA: the checks also offer the pre-releases (8.6.0-beta1) -->
    <CheckBoxPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_update"
        android:key="pref_beta_updates"
        android:summary="@string/beta_updates_desc"
        android:title="@string/beta_updates" />

    <!--<Preference
        android:icon="@drawable/ic_plus_version"
        android:key="version_plus"
        android:summary="@string/how_is"
        android:title="@string/getPlus" />-->

    <Preference
        android:icon="@drawable/ic_privacy"
        android:key="privacy"
        android:title="@string/privacy" />

    <Preference
        android:icon="@drawable/ic_battery"
        android:key="disable_battary_optimize"
        android:summary="@string/battary_optimize_desc"
        android:title="@string/battary_optimize" />

    <!-- a TV only (AboutFragment hides it elsewhere) -->
    <Preference
        android:icon="@drawable/ic_screen_off"
        android:key="tv_screen_hint"
        android:persistent="false"
        android:selectable="false"
        android:summary="@string/screen_off_hint"
        android:title="@string/screen_off_hint_title" />

    <Preference
        android:icon="@drawable/ic_github"
        android:key="open_github"
        android:title="@string/open_github" />

    <!-- the region of the connection (AppRegion; not the key "region", that is AppRegion.PREF_REGION); a click opens
         db-ip.com, the source of the IP-to-region table (assets/region, tools/region/build_ip_regions.py) -->
    <Preference
        android:icon="@drawable/ic_location"
        android:key="about_region"
        android:persistent="false" />


</PreferenceScreen>
